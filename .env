# This file is for LOCAL TESTING ONLY (running the script on your own
# machine with `python send_daily_email.py`). Copy it to ".env" and fill
# in real values. NEVER commit the real ".env" -- it's in .gitignore.
#
# For the actual GitHub Actions schedule, you do NOT use this file --
# instead you add these same values as repo Secrets under:
# Settings -> Secrets and variables -> Actions -> New repository secret

TO_EMAIL=damienfranklin2000@gmail.com
FROM_EMAIL=damienfranklin2000@gmail.com
FROM_NAME=Catholic Calendar

# --- Option 1: SendGrid (leave blank to use SMTP below instead) ---
SENDGRID_API_KEY=
# --- Option 2: SMTP, e.g. Gmail with an App Password ---
# (Gmail: Google Account -> Security -> 2-Step Verification -> App Passwords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=damienfranklin2000@gmail.com
EMAIL_PASSWORD=dwsd dhim drlc mlsb

TIMEZONE=Africa/Lagos
SEND_ON_ORDINARY_DAYS=True
